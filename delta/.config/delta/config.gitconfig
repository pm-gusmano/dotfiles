# Generated by scripts/render-theme. Edit themes/current.toml or themes/*.toml instead.
[delta]
    light = true
    dark = false
    true-color = always
    syntax-theme = "Catppuccin Latte"
    line-numbers = true
    keep-plus-minus-markers = true
    file-style = "#8839ef bold"
    hunk-header-style = "file line-number syntax"
    hunk-header-file-style = "#7287fd bold"
    hunk-header-line-number-style = "#7c7f93"
    hunk-header-decoration-style = "#dce0e8"
    line-numbers-left-style = "#7c7f93"
    line-numbers-right-style = "#7c7f93"
    line-numbers-minus-style = "#d20f39"
    line-numbers-plus-style = "#40a02b"
    line-numbers-zero-style = "#7c7f93"
    minus-style = "syntax #bcc0cc"
    minus-emph-style = "syntax #bcc0cc bold"
    plus-style = "syntax #bcc0cc"
    plus-emph-style = "syntax #bcc0cc bold"
    zero-style = "syntax #eff1f5"
    commit-style = "#df8e1d bold"
    blame-code-style = "syntax"
    blame-separator-style = "#dce0e8"
    grep-file-style = "#8839ef bold"
    grep-line-number-style = "#7c7f93"
    grep-match-line-style = "syntax #bcc0cc"
    grep-match-word-style = "#4c4f69 #bcc0cc bold"
