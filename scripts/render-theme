#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Literal
import tomllib


ROOT = Path(__file__).resolve().parents[1]
THEME_CONFIG = ROOT / "themes" / "current.toml"
THEMES_DIR = ROOT / "themes"
CODEX_CONFIG = ROOT / "codex/.codex/config.toml"
DELTA_CONFIG = ROOT / "delta/.config/delta/config.gitconfig"
JJ_CONFIG = ROOT / "jj/.config/jj/config.toml"
LIVE_JJ_CONFIG = Path.home() / ".config/jj/config.toml"
ZELLIJ_CONFIG_DIR = ROOT / "zellij/.config/zellij"
LIVE_ZELLIJ_CONFIG_DIR = Path.home() / ".config/zellij"
ALACRITTY_ZELLIJ_PROGRAM = "/home/pm-gusmano/.nix-profile/bin/zellij"
GENERATED_MARKER = "Generated by scripts/render-theme. Edit themes/current.toml or themes/*.toml instead."
HEADER_TOML = f"# {GENERATED_MARKER}\n"
HEADER_LUA = f"-- {GENERATED_MARKER}\n"
HEADER_KDL = f"// {GENERATED_MARKER}\n"
ZELLIJ_BLOCK_START = "// BEGIN GENERATED THEME"
ZELLIJ_BLOCK_END = "// END GENERATED THEME"

Appearance = Literal["dark", "light"]


@dataclass(frozen=True)
class Theme:
    key: str
    name: str
    flavour: str
    appearance: Appearance
    palette: dict[str, str]
    semantic: dict[str, str]

    @property
    def colorscheme(self) -> str:
        return f"{self.name}-{self.flavour}"


def load_toml(path: Path) -> dict:
    return tomllib.loads(path.read_text())


def load_config() -> dict:
    return load_toml(THEME_CONFIG)


def load_theme(theme_key: str) -> Theme:
    path = THEMES_DIR / f"{theme_key}.toml"
    if not path.exists():
        raise SystemExit(f"Unknown theme {theme_key!r}; expected {path}")

    data = load_toml(path)
    appearance = data["appearance"]
    if appearance not in {"dark", "light"}:
        raise SystemExit(f"{path} appearance must be dark or light")

    return Theme(
        key=theme_key,
        name=data["name"],
        flavour=data["flavour"],
        appearance=appearance,
        palette=data["palette"],
        semantic=data["semantic"],
    )


def selected_theme_key(config: dict, mode: str | None, theme: str | None) -> tuple[str, Appearance]:
    if theme:
        loaded = load_theme(theme)
        return loaded.key, loaded.appearance

    requested_mode = mode or config.get("mode", "auto")
    if requested_mode == "auto":
        appearance = detect_system_appearance() or config.get("fallback", "dark")
    elif requested_mode in {"dark", "light"}:
        appearance = requested_mode
    else:
        raise SystemExit("Mode must be one of: auto, dark, light")

    if appearance not in {"dark", "light"}:
        raise SystemExit("Theme appearance must be dark or light")

    try:
        return config[appearance], appearance
    except KeyError as exc:
        raise SystemExit(f"themes/current.toml is missing {appearance!r} theme mapping") from exc


def detect_system_appearance() -> Appearance | None:
    return (
        detect_from_env()
        or detect_from_windows_registry()
        or detect_from_gsettings()
    )


def detect_from_env() -> Appearance | None:
    value = (
        os.environ.get("DOTFILES_COLOR_SCHEME")
        or os.environ.get("COLOR_SCHEME")
        or ""
    ).lower()
    if value in {"dark", "prefer-dark"}:
        return "dark"
    if value in {"light", "prefer-light"}:
        return "light"
    return None


def detect_from_windows_registry() -> Appearance | None:
    try:
        result = subprocess.run(
            [
                "reg.exe",
                "query",
                r"HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize",
                "/v",
                "AppsUseLightTheme",
            ],
            check=False,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        return None

    if result.returncode != 0:
        return None

    match = re.search(r"AppsUseLightTheme\s+REG_DWORD\s+0x([0-9a-fA-F]+)", result.stdout)
    if not match:
        return None

    return "light" if int(match.group(1), 16) else "dark"


def detect_from_gsettings() -> Appearance | None:
    try:
        result = subprocess.run(
            ["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
            check=False,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        return None

    if result.returncode != 0:
        return None

    value = result.stdout.strip().strip("'").lower()
    if value == "prefer-dark":
        return "dark"
    if value == "prefer-light":
        return "light"
    return None


def color(theme: Theme, name: str) -> str:
    return theme.palette[theme.semantic.get(name, name)]


def palette_role(theme: Theme, name: str, fallback: str) -> str:
    return theme.palette[theme.semantic.get(name, fallback)]


def write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def same_path(left: Path, right: Path) -> bool:
    try:
        return left.resolve() == right.resolve()
    except FileNotFoundError:
        return left.absolute() == right.absolute()


def toml_string(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def set_toml_table_key(path: Path, table: str, key: str, value: str) -> None:
    set_toml_table_literal(path, table, key, toml_string(value))


def set_toml_table_literal(path: Path, table: str, key: str, rendered_value: str) -> None:
    content = path.read_text()
    lines = content.splitlines()
    header_re = re.compile(r"^\s*\[([^\]]+)\]\s*(?:#.*)?$")
    target_header = f"[{table}]"
    generated_comment = f"# {GENERATED_MARKER}"
    rendered_key = f"{key} = {rendered_value}"

    def is_generated_comment(line: str) -> bool:
        return line.strip().startswith("#") and GENERATED_MARKER in line

    table_start = None
    for idx, line in enumerate(lines):
        if line.strip() == target_header:
            table_start = idx
            break

    if table_start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.extend([target_header, generated_comment, rendered_key])
        path.write_text("\n".join(lines) + "\n")
        return

    table_end = len(lines)
    for idx in range(table_start + 1, len(lines)):
        if header_re.match(lines[idx]):
            table_end = idx
            break

    key_re = re.compile(rf"^\s*{re.escape(key)}\s*=")
    for idx in range(table_start + 1, table_end):
        if key_re.match(lines[idx]):
            lines[idx] = rendered_key
            if idx == table_start + 1 or not is_generated_comment(lines[idx - 1]):
                lines.insert(idx, generated_comment)
            path.write_text("\n".join(lines) + "\n")
            return

    insert_at = table_start + 1
    lines[insert_at:insert_at] = [generated_comment, rendered_key]
    path.write_text("\n".join(lines) + "\n")


def style(**attrs: str | bool) -> str:
    parts = []
    for key, value in attrs.items():
        if isinstance(value, bool):
            rendered = "true" if value else "false"
        else:
            rendered = f'"{value}"'
        parts.append(f"{key} = {rendered}")
    return "{ " + ", ".join(parts) + " }"


def hex_to_rgb(value: str) -> tuple[int, int, int]:
    normalized = value.removeprefix("#")
    return (
        int(normalized[0:2], 16),
        int(normalized[2:4], 16),
        int(normalized[4:6], 16),
    )


def rgb_kdl(value: str) -> str:
    return " ".join(str(part) for part in hex_to_rgb(value))


def render_alacritty(theme: Theme) -> None:
    bg = color(theme, "background")
    fg = color(theme, "foreground")
    border = color(theme, "panel_border")
    selection = color(theme, "selection")
    palette = theme.palette

    content = f"""{HEADER_TOML}[terminal.shell]
program = "{ALACRITTY_ZELLIJ_PROGRAM}"
args = ["attach", "--create", "main"]

[window.padding]
x = 2
y = 2

[font]
size = 12
normal = {{ family = "FiraCode Nerd Font Mono", style = "Regular" }}

[keyboard]
bindings = [
  {{ key = "F11", action = "ToggleFullscreen" }},
  {{ key = "Enter", mods = "Alt", action = "ReceiveChar" }},
]

[colors.primary]
background = "{bg}"
foreground = "{fg}"
dim_foreground = "{color(theme, "dim_foreground")}"
bright_foreground = "{fg}"

[colors.cursor]
text = "{bg}"
cursor = "{palette["rosewater"]}"

[colors.vi_mode_cursor]
text = "{bg}"
cursor = "{palette["lavender"]}"

[colors.search.matches]
foreground = "{bg}"
background = "{palette["subtext0"]}"

[colors.search.focused_match]
foreground = "{bg}"
background = "{palette["green"]}"

[colors.footer_bar]
foreground = "{fg}"
background = "{border}"

[colors.hints.start]
foreground = "{bg}"
background = "{palette["yellow"]}"

[colors.hints.end]
foreground = "{fg}"
background = "{border}"

[colors.selection]
text = "{fg}"
background = "{selection}"

[colors.normal]
black = "{palette_role(theme, "ansi_black", "panel_border")}"
red = "{palette["red"]}"
green = "{palette["green"]}"
yellow = "{palette["yellow"]}"
blue = "{palette["blue"]}"
magenta = "{palette["pink"]}"
cyan = "{palette["teal"]}"
white = "{palette["subtext1"]}"

[colors.bright]
black = "{palette_role(theme, "ansi_bright_black", "overlay0")}"
red = "{palette["red"]}"
green = "{palette["green"]}"
yellow = "{palette["yellow"]}"
blue = "{palette["blue"]}"
magenta = "{palette["pink"]}"
cyan = "{palette["teal"]}"
white = "{palette["subtext0"]}"

[colors.dim]
black = "{palette_role(theme, "ansi_dim_black", "base")}"
red = "{palette["red"]}"
green = "{palette["green"]}"
yellow = "{palette["yellow"]}"
blue = "{palette["blue"]}"
magenta = "{palette["pink"]}"
cyan = "{palette["teal"]}"
white = "{palette["subtext1"]}"
"""
    write(ROOT / "alacritty/.config/alacritty/alacritty.toml", content)


def render_nvim(theme: Theme) -> None:
    semantic = theme.semantic
    content = f"""{HEADER_LUA}return {{
  {{
    "catppuccin/nvim",
    name = "catppuccin",
    lazy = false,
    priority = 1000,
    opts = {{
      flavour = "{theme.flavour}",
      term_colors = true,
      custom_highlights = function(colors)
        return {{
          Normal = {{ bg = colors.{semantic["background"]} }},
          NormalNC = {{ bg = colors.{semantic["background"]} }},
          SignColumn = {{ bg = colors.{semantic["background"]} }},
          StatusLine = {{ bg = colors.{semantic["panel"]} }},
          WinSeparator = {{ fg = colors.overlay0 }},
          CursorLine = {{ bg = colors.{semantic["panel"]} }},
          ColorColumn = {{ bg = colors.{semantic["panel"]} }},
          Visual = {{ bg = colors.{semantic["selection"]} }},
          NormalFloat = {{ bg = colors.{semantic["panel"]} }},
          FloatBorder = {{ fg = colors.{semantic["accent"]}, bg = colors.{semantic["panel"]} }},
          Pmenu = {{ bg = colors.{semantic["panel"]} }},
          PmenuSel = {{ bg = colors.{semantic["selection"]}, fg = colors.{semantic["foreground"]} }},
        }}
      end,
    }},
  }},
  {{
    "LazyVim/LazyVim",
    opts = {{
      colorscheme = "{theme.colorscheme}",
    }},
  }},
}}
"""
    write(ROOT / "nvim/.config/nvim/lua/plugins/colorscheme.lua", content)


def render_jjui(theme: Theme) -> None:
    config = f"""{HEADER_TOML}[ui]
theme = "{theme.colorscheme}"
"""
    write(ROOT / "jjui/.config/jjui/config.toml", config)

    write(ROOT / f"jjui/.config/jjui/themes/{theme.colorscheme}.toml", render_jjui_theme(theme))


def render_delta(theme: Theme) -> None:
    bg = color(theme, "background")
    fg = color(theme, "foreground")
    dim = color(theme, "dim_foreground")
    border = color(theme, "panel_border")
    selection = color(theme, "selection")
    syntax_theme = " ".join(part.capitalize() for part in theme.colorscheme.split("-"))
    mode = "dark" if theme.appearance == "dark" else "light"
    inverse_mode = "light" if theme.appearance == "dark" else "dark"

    content = f"""{HEADER_TOML}[delta]
    {mode} = true
    {inverse_mode} = false
    true-color = always
    syntax-theme = "{syntax_theme}"
    line-numbers = true
    keep-plus-minus-markers = true
    file-style = "{color(theme, "accent")} bold"
    hunk-header-style = "file line-number syntax"
    hunk-header-file-style = "{color(theme, "accent_alt")} bold"
    hunk-header-line-number-style = "{dim}"
    hunk-header-decoration-style = "{border}"
    line-numbers-left-style = "{dim}"
    line-numbers-right-style = "{dim}"
    line-numbers-minus-style = "{color(theme, "error")}"
    line-numbers-plus-style = "{color(theme, "success")}"
    line-numbers-zero-style = "{dim}"
    minus-style = "syntax {selection}"
    minus-emph-style = "syntax {selection} bold"
    plus-style = "syntax {selection}"
    plus-emph-style = "syntax {selection} bold"
    zero-style = "syntax {bg}"
    commit-style = "{color(theme, "warning")} bold"
    blame-code-style = "syntax"
    blame-separator-style = "{border}"
    grep-file-style = "{color(theme, "accent")} bold"
    grep-line-number-style = "{dim}"
    grep-match-line-style = "syntax {selection}"
    grep-match-word-style = "{fg} {selection} bold"
"""
    write(DELTA_CONFIG, content)
    jj_configs = [JJ_CONFIG]
    if not same_path(LIVE_JJ_CONFIG, JJ_CONFIG) and LIVE_JJ_CONFIG.exists():
        jj_configs.append(LIVE_JJ_CONFIG)
    for jj_config in jj_configs:
        set_toml_table_key(jj_config, "ui", "color", "always")
        set_toml_table_key(jj_config, "ui", "diff-formatter", "delta")
        set_toml_table_literal(
            jj_config,
            "ui",
            "pager",
            '["less", "-RFX"]',
        )
        set_toml_table_literal(
            jj_config,
            "merge-tools.delta",
            "diff-args",
            f'["--config", {toml_string(str(DELTA_CONFIG))}, "--paging=never", "$left", "$right"]',
        )


def render_jjui_theme(theme: Theme) -> str:
    bg = color(theme, "background")
    fg = color(theme, "foreground")
    panel = color(theme, "panel")
    border = color(theme, "panel_border")
    selection = color(theme, "selection")
    dim = color(theme, "dim_foreground")
    accent = color(theme, "accent")
    accent_alt = color(theme, "accent_alt")

    entries = {
        "text": style(fg=fg, bg=bg),
        "dimmed": style(fg=dim),
        "selected": style(fg=fg, bg=selection, bold=True),
        "border": style(fg=border),
        "title": style(fg=accent, bold=True),
        "shortcut": style(fg=color(theme, "info"), bold=True),
        "matched": style(fg=color(theme, "warning"), bold=True),
        "source_marker": style(fg=bg, bg=color(theme, "success"), bold=True),
        "target_marker": style(fg=bg, bg=accent_alt, bold=True),
        "status": style(fg=fg, bg=panel),
        "status title": style(fg=bg, bg=accent, bold=True),
        "status shortcut": style(fg=color(theme, "info"), bold=True),
        "status dimmed": style(fg=dim),
        "revset title": style(fg=accent, bold=True),
        "revset text": style(fg=fg, bold=True),
        "revset completion selected": style(fg=fg, bg=selection, bold=True),
        "revset completion matched": style(fg=color(theme, "warning"), bold=True),
        "revset completion dimmed": style(fg=dim),
        "revisions": style(fg=fg, bg=bg),
        "revisions selected": style(fg=fg, bg=selection, bold=True),
        "revisions dimmed": style(fg=dim),
        "oplog selected": style(fg=fg, bg=selection, bold=True),
        "evolog": style(fg=fg, bg=panel),
        "evolog selected": style(fg=fg, bg=selection, bold=True),
        "help": style(fg=fg, bg=panel),
        "help title": style(fg=accent, bold=True, underline=True),
        "help border": style(fg=border),
        "menu": style(fg=fg, bg=panel),
        "menu title": style(fg=accent, bold=True),
        "menu shortcut": style(fg=color(theme, "info"), bold=True),
        "menu dimmed": style(fg=dim),
        "menu border": style(fg=border),
        "menu selected": style(fg=fg, bg=selection, bold=True),
        "confirmation": style(fg=fg, bg=panel),
        "confirmation text": style(fg=fg),
        "confirmation selected": style(fg=fg, bg=selection, bold=True),
        "confirmation dimmed": style(fg=dim),
        "confirmation border": style(fg=color(theme, "warning")),
        "undo": style(fg=fg, bg=panel),
        "undo confirmation dimmed": style(fg=dim),
        "undo confirmation selected": style(fg=fg, bg=selection, bold=True),
        "preview": style(fg=fg, bg=bg),
        "preview border": style(fg=border),
    }
    theme_body = "\n".join(f'"{key}" = {value}' for key, value in entries.items())
    return HEADER_TOML + theme_body + "\n"


def zellij_theme_set(active_theme: Theme) -> list[Theme]:
    config = load_config()
    keys = [active_theme.key, config.get("dark"), config.get("light")]
    themes: list[Theme] = []
    seen: set[str] = set()
    for key in keys:
        if not key or key in seen:
            continue
        themes.append(load_theme(key))
        seen.add(key)
    return themes


def render_zellij(theme: Theme) -> None:
    zellij_themes = zellij_theme_set(theme)
    sync_live_zellij = not same_path(LIVE_ZELLIJ_CONFIG_DIR, ZELLIJ_CONFIG_DIR)
    for zellij_theme in zellij_themes:
        theme_content = render_zellij_theme(zellij_theme)
        write(ZELLIJ_CONFIG_DIR / f"themes/{zellij_theme.colorscheme}.kdl", theme_content)
        if sync_live_zellij:
            write(LIVE_ZELLIJ_CONFIG_DIR / f"themes/{zellij_theme.colorscheme}.kdl", theme_content)

    dark = next((item for item in zellij_themes if item.appearance == "dark"), None)
    light = next((item for item in zellij_themes if item.appearance == "light"), None)
    update_zellij_config(
        ZELLIJ_CONFIG_DIR / "config.kdl",
        theme.colorscheme,
        dark.colorscheme if dark else None,
        light.colorscheme if light else None,
    )

    if sync_live_zellij:
        live_config = LIVE_ZELLIJ_CONFIG_DIR / "config.kdl"
        if live_config.exists():
            update_zellij_config(
                live_config,
                theme.colorscheme,
                dark.colorscheme if dark else None,
                light.colorscheme if light else None,
            )
        else:
            live_config.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(ZELLIJ_CONFIG_DIR / "config.kdl", live_config)

    apply_zellij_theme(theme.appearance)


def render_zellij_theme(theme: Theme) -> str:
    palette = theme.palette
    lines = [
        HEADER_KDL,
        "themes {",
        f"    {theme.colorscheme} {{",
        f"        fg {rgb_kdl(color(theme, 'foreground'))}",
        f"        bg {rgb_kdl(color(theme, 'background'))}",
        f"        red {rgb_kdl(palette['red'])}",
        f"        green {rgb_kdl(palette['green'])}",
        f"        yellow {rgb_kdl(palette['yellow'])}",
        f"        blue {rgb_kdl(palette['blue'])}",
        f"        magenta {rgb_kdl(palette['pink'])}",
        f"        orange {rgb_kdl(palette['peach'])}",
        f"        cyan {rgb_kdl(palette['teal'])}",
        f"        black {rgb_kdl(color(theme, 'panel_border'))}",
        f"        white {rgb_kdl(palette['subtext1'])}",
        "    }",
        "}",
        "",
    ]
    return "\n".join(lines)


def update_zellij_config(
    config_path: Path,
    theme_name: str,
    dark_theme_name: str | None = None,
    light_theme_name: str | None = None,
) -> None:
    content = config_path.read_text()
    paired_theme_lines = ""
    if dark_theme_name:
        paired_theme_lines += f'theme_dark "{dark_theme_name}"\n'
    if light_theme_name:
        paired_theme_lines += f'theme_light "{light_theme_name}"\n'
    block = (
        f"{ZELLIJ_BLOCK_START}\n"
        f"{HEADER_KDL}"
        f'theme "{theme_name}"\n'
        f"{paired_theme_lines}"
        f"{ZELLIJ_BLOCK_END}\n"
    )

    pattern = re.compile(
        rf"{re.escape(ZELLIJ_BLOCK_START)}\n.*?{re.escape(ZELLIJ_BLOCK_END)}\n?",
        re.DOTALL,
    )
    if pattern.search(content):
        content = pattern.sub(block, content, count=1)
    else:
        content = block + "\n" + content
    config_path.write_text(content)


def apply_zellij_theme(appearance: Appearance) -> None:
    if "ZELLIJ" not in os.environ:
        return

    action = "set-dark-theme" if appearance == "dark" else "set-light-theme"
    subprocess.run(
        ["zellij", "action", action],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def render_theme(theme: Theme) -> None:
    render_alacritty(theme)
    render_nvim(theme)
    render_jjui(theme)
    render_delta(theme)
    render_zellij(theme)
    render_codex(theme)


def render_codex(theme: Theme) -> None:
    set_toml_table_key(CODEX_CONFIG, "tui", "theme", theme.colorscheme)


def sync_windows_alacritty() -> None:
    subprocess.run([str(ROOT / "scripts/sync-alacritty-to-windows")], check=True)


def render_selected(args: argparse.Namespace) -> Theme:
    config = load_config()
    theme_key, _appearance = selected_theme_key(config, args.mode, args.theme)
    theme = load_theme(theme_key)
    render_theme(theme)
    if args.sync_windows_alacritty:
        sync_windows_alacritty()
    return theme


def watch(args: argparse.Namespace) -> None:
    config = load_config()
    interval = args.interval or config.get("watch", {}).get("interval_seconds", 5)
    previous_key = ""

    while True:
        config = load_config()
        theme_key, appearance = selected_theme_key(config, args.mode, args.theme)
        if theme_key != previous_key:
            theme = load_theme(theme_key)
            render_theme(theme)
            if args.sync_windows_alacritty:
                sync_windows_alacritty()
            print(f"Rendered {theme.colorscheme} for {appearance} mode")
            previous_key = theme_key
        time.sleep(interval)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Render dotfile colors from the central theme registry.")
    parser.add_argument("--mode", choices=["auto", "dark", "light"], help="Select a mapped appearance.")
    parser.add_argument("--theme", help="Render a specific theme key, such as catppuccin-mocha.")
    parser.add_argument("--watch", action="store_true", help="Poll the system color scheme and re-render on changes.")
    parser.add_argument("--interval", type=float, help="Polling interval in seconds for --watch.")
    parser.add_argument(
        "--sync-windows-alacritty",
        action="store_true",
        help="Also copy the generated Alacritty config to the Windows profile path.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.watch:
        watch(args)
    else:
        theme = render_selected(args)
        print(f"Rendered {theme.colorscheme}")


if __name__ == "__main__":
    main()
